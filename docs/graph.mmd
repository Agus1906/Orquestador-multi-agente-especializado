---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	supervisor(supervisor)
	research(research)
	analyst(analyst)
	synthesis(synthesis)
	stop(stop)
	__end__([<p>__end__</p>]):::last
	__start__ --> supervisor;
	analyst --> supervisor;
	research --> supervisor;
	supervisor -.-> analyst;
	supervisor -.-> research;
	supervisor -.-> stop;
	supervisor -.-> synthesis;
	stop --> __end__;
	synthesis --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
